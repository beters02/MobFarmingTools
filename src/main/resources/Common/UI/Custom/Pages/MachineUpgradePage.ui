// Generic machine upgrade page

$C = "../Common.ui";

@SlotSize = 74;
@SlotSpacing = 2;
@SlotsPerRow = 9;
@GridPadding = 2;
@GridWidth = ((@SlotSize * @SlotsPerRow) + (@SlotSpacing * (@SlotsPerRow - 1)) + (@GridPadding * 2)) + 50;
@ContainerWidth = 900;
@PanelSpacing = 8;

$C.@PageOverlay {}

Group #PageLayout {
  Anchor: (Width: @ContainerWidth, Top: 70, Bottom: 20);
  LayoutMode: Top;

  $C.@Container #UpgradeContainer {
    Anchor: (Width: @ContainerWidth, Bottom: @PanelSpacing);

    #Title {
      LayoutMode: Left;

      $C.@Title #UpgradeTitle {
        @Text = "Machine Upgrades";
      }

      Group {
        FlexWeight: 1;
      }

      Button #PreviewButton {
        Anchor: (Width: 140, Height: 32);
        Style: (
          Default: (Background: (Color: #223047)),
          Hovered: (Background: (Color: #2b3d57)),
          Pressed: (Background: (Color: #1a2436))
        );

        Label #PreviewButtonLabel {
          Text: "Preview: Off";
          Style: (
            FontSize: 14,
            TextColor: #e0e8f0,
            RenderBold: true,
            HorizontalAlignment: Center,
            VerticalAlignment: Center
          );
          Anchor: (Full: 0);
        }
      }
    }

    #Content {
      LayoutMode: Left;

      Group #UpgradeSlotsContainer {
        LayoutMode: LeftCenterWrap;
        Anchor: (Height: 270, Width: 538);
      }

      Group #StatsContainer {
        Anchor: (Height: 270, Width: 200, Left: 60);
        LayoutMode: Top;
        Background: (Color: #131c27(0.75));
        Padding: (Left: 8, Right: 8, Top: 8, Bottom: 8);

        Label {
          Text: "Stats";
          Style: (
            FontSize: 14,
            TextColor: #e0e8f0,
            RenderBold: true,
            HorizontalAlignment: Start,
            VerticalAlignment: Center
          );
          Anchor: (Height: 22, Bottom: 6);
        }

        Group #Stats {
          LayoutMode: Top;

          Group #StatLine0 {
            Visible: false;
            Anchor: (Height: 18, Bottom: 2);
            LayoutMode: Left;
            Label #StatDesc { Text: ""; Style: (FontSize: 12, TextColor: #b8c7d9, HorizontalAlignment: Start, VerticalAlignment: Center); }
            Group { FlexWeight: 1; }
            Label #StatValue { Text: ""; Anchor: (Height: 18); Style: (FontSize: 12, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: Center, RenderBold: true); }
          }
          Group #StatLine1 {
            Visible: false;
            Anchor: (Height: 18, Bottom: 2);
            LayoutMode: Left;
            Label #StatDesc { Text: ""; Style: (FontSize: 12, TextColor: #b8c7d9, HorizontalAlignment: Start, VerticalAlignment: Center); }
            Group { FlexWeight: 1; }
            Label #StatValue { Text: ""; Anchor: (Height: 18); Style: (FontSize: 12, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: Center, RenderBold: true); }
          }
          Group #StatLine2 {
            Visible: false;
            Anchor: (Height: 18, Bottom: 2);
            LayoutMode: Left;
            Label #StatDesc { Text: ""; Style: (FontSize: 12, TextColor: #b8c7d9, HorizontalAlignment: Start, VerticalAlignment: Center); }
            Group { FlexWeight: 1; }
            Label #StatValue { Text: ""; Anchor: (Height: 18); Style: (FontSize: 12, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: Center, RenderBold: true); }
          }
          Group #StatLine3 {
            Visible: false;
            Anchor: (Height: 18, Bottom: 2);
            LayoutMode: Left;
            Label #StatDesc { Text: ""; Style: (FontSize: 12, TextColor: #b8c7d9, HorizontalAlignment: Start, VerticalAlignment: Center); }
            Group { FlexWeight: 1; }
            Label #StatValue { Text: ""; Anchor: (Height: 18); Style: (FontSize: 12, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: Center, RenderBold: true); }
          }
          Group #StatLine4 {
            Visible: false;
            Anchor: (Height: 18, Bottom: 2);
            LayoutMode: Left;
            Label #StatDesc { Text: ""; Style: (FontSize: 12, TextColor: #b8c7d9, HorizontalAlignment: Start, VerticalAlignment: Center); }
            Group { FlexWeight: 1; }
            Label #StatValue { Text: ""; Anchor: (Height: 18); Style: (FontSize: 12, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: Center, RenderBold: true); }
          }
          Group #StatLine5 {
            Visible: false;
            Anchor: (Height: 18, Bottom: 2);
            LayoutMode: Left;
            Label #StatDesc { Text: ""; Style: (FontSize: 12, TextColor: #b8c7d9, HorizontalAlignment: Start, VerticalAlignment: Center); }
            Group { FlexWeight: 1; }
            Label #StatValue { Text: ""; Anchor: (Height: 18); Style: (FontSize: 12, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: Center, RenderBold: true); }
          }
          Group #StatLine6 {
            Visible: false;
            Anchor: (Height: 18, Bottom: 2);
            LayoutMode: Left;
            Label #StatDesc { Text: ""; Style: (FontSize: 12, TextColor: #b8c7d9, HorizontalAlignment: Start, VerticalAlignment: Center); }
            Group { FlexWeight: 1; }
            Label #StatValue { Text: ""; Anchor: (Height: 18); Style: (FontSize: 12, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: Center, RenderBold: true); }
          }
          Group #StatLine7 {
            Visible: false;
            Anchor: (Height: 18, Bottom: 2);
            LayoutMode: Left;
            Label #StatDesc { Text: ""; Style: (FontSize: 12, TextColor: #b8c7d9, HorizontalAlignment: Start, VerticalAlignment: Center); }
            Group { FlexWeight: 1; }
            Label #StatValue { Text: ""; Anchor: (Height: 18); Style: (FontSize: 12, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: Center, RenderBold: true); }
          }
          Group #StatLine8 {
            Visible: false;
            Anchor: (Height: 18, Bottom: 2);
            LayoutMode: Left;
            Label #StatDesc { Text: ""; Style: (FontSize: 12, TextColor: #b8c7d9, HorizontalAlignment: Start, VerticalAlignment: Center); }
            Group { FlexWeight: 1; }
            Label #StatValue { Text: ""; Anchor: (Height: 18); Style: (FontSize: 12, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: Center, RenderBold: true); }
          }
          Group #StatLine9 {
            Visible: false;
            Anchor: (Height: 18, Bottom: 2);
            LayoutMode: Left;
            Label #StatDesc { Text: ""; Style: (FontSize: 12, TextColor: #b8c7d9, HorizontalAlignment: Start, VerticalAlignment: Center); }
            Group { FlexWeight: 1; }
            Label #StatValue { Text: ""; Anchor: (Height: 18); Style: (FontSize: 12, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: Center, RenderBold: true); }
          }
        }
      }
    }
  }

  $C.@Container #InventoryContainer {
    Anchor: (Width: @ContainerWidth);

    #Title {
      $C.@Title {
        @Text = "Inventory";
      }
    }

    #Content {
      LayoutMode: Top;

      Group #PlayerInventoryWrapper {
        Anchor: (Height: 380);

        Group #PlayerInventoryContainer {
          Anchor: (Height: 380, Width: @GridWidth);
          LayoutMode: Top;
          Background: #202c3b(0);
          Padding: (Full: 0);

          Group #PlayerInventory {
            Anchor: (Width: @GridWidth);
            LayoutMode: LeftCenterWrap;
          }
        }
      }
    }
  }
}

$C.@BackButton #BackButton {}
